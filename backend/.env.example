# ==========================================
# VTSC PaintPro - Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Database (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vtsc_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_random
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# IPFS Pinata (Decentralized Storage for PDFs/Invoices)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Blockchain & Web3 (Sepolia Testnet)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_or_alchemy_project_id
CONTRACT_ADDRESS=your_deployed_contract_address
SYSTEM_PRIVATE_KEY=your_system_wallet_private_key
VTSC_WALLET=your_vtsc_company_wallet_address

# AI Chatbot (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key

# Payment Gateway - MoMo (Optional)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create

# Email SMTP Notification (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
ALERT_FROM=your_email@gmail.com
